# GitHub Secrets Configuration
# Copy this to github_secrets.env and fill in your actual values
# This file should be added to .gitignore

# Scaleway API credentials
SCW_ACCESS_KEY="REPLACE_WITH_YOUR_SCALEWAY_API_ACCESS_KEY"
SCW_SECRET_KEY="REPLACE_WITH_YOUR_SCALEWAY_API_SECRET_KEY"

# Scaleway organization and project info
SCW_ORGANIZATION_ID="REPLACE_WITH_YOUR_ORGANIZATION_ID"
SCW_PROJECT_ID="REPLACE_WITH_YOUR_PROJECT_ID"

# Container registry and deployment info
# SCW_REGISTRY_ENDPOINT: terraform -chdir=deployment/scaleway output -raw registry_endpoint
# SCW_CONTAINER_ID: terraform -chdir=deployment/scaleway output -raw container_id | cut -d '/' -f 2
SCW_REGISTRY_ENDPOINT="rg.fr-par.scw.cloud/wisselschema"
SCW_CONTAINER_ID="REPLACE_WITH_YOUR_CONTAINER_ID"
